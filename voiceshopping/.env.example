# Keep real values only in an ignored .env file or a secure secret store.
OPENAI_API_KEY=

# Keep store automation disabled until you have reviewed the current retailer
# terms, verified the selectors, and enabled it explicitly.
COLES_ENABLED=false
COLES_USERNAME=
COLES_PASSWORD=
WOOLWORTHS_ENABLED=false
WOOLWORTHS_USERNAME=
WOOLWORTHS_PASSWORD=

BROWSER_HEADLESS=false
BROWSER_TIMEOUT=20
VOICE_RATE=150
VOICE_VOLUME=1.0
